{
  "name": "cj-knob",
  "version": "1.0.0",
  "description": "A zero-dependency SVG knob, gauge and meter web component.",
  "type": "module",
  "main": "./src/cj-knob.js",
  "module": "./src/cj-knob.js",
  "types": "./types/cj-knob.d.ts",
  "exports": {
    ".": {
      "types": "./types/cj-knob.d.ts",
      "default": "./src/cj-knob.js"
    },
    "./radar": {
      "types": "./types/cj-radar.d.ts",
      "default": "./src/cj-radar.js"
    },
    "./package.json": "./package.json",
    "./horizon": {
      "types": "./types/cj-horizon.d.ts",
      "default": "./src/cj-horizon.js"
    },
    "./level": {
      "types": "./types/cj-level.d.ts",
      "default": "./src/cj-level.js"
    },
    "./rings": {
      "types": "./types/cj-rings.d.ts",
      "default": "./src/cj-rings.js"
    },
    "./trace": {
      "types": "./types/cj-trace.d.ts",
      "default": "./src/cj-trace.js"
    },
    "./heat": {
      "types": "./types/cj-heat.d.ts",
      "default": "./src/cj-heat.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "sideEffects": [
    "./src/cj-knob.js",
    "./src/cj-radar.js",
    "./src/cj-horizon.js",
    "./src/cj-level.js",
    "./src/cj-rings.js"
  ],
  "keywords": [
    "knob",
    "gauge",
    "meter",
    "dial",
    "progress",
    "radial",
    "svg",
    "web-component",
    "custom-element",
    "radar",
    "compass",
    "needle",
    "attitude-indicator",
    "artificial-horizon",
    "gyro",
    "level",
    "tank",
    "thermometer",
    "gradient",
    "concentric",
    "rings"
  ],
  "author": "tanghoong",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanghoong/cj-knob.git"
  },
  "homepage": "https://github.com/tanghoong/cj-knob#readme",
  "bugs": {
    "url": "https://github.com/tanghoong/cj-knob/issues"
  },
  "scripts": {
    "dev": "npx --yes serve -l 8765 .",
    "check": "node --check src/cj-knob.js && node --check src/cj-radar.js && node --check src/cj-horizon.js && node --check src/cj-level.js && node --check src/cj-rings.js && node --check src/cj-trace.js && node --check src/cj-heat.js",
    "test": "node test/knob.test.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
